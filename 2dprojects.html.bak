    <style>
        body {
            overflow: hidden;
        }

        .subpage-main {
            position: fixed;
            top: 60px;
            /* Claim the adjusted 60px header space */
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding-bottom: 10px;
            /* Padding for slider at the bottom */
            background: #fff;
        }

        .subpage-main h2 {
            font-size: 32px;
            line-height: 1;
            flex-shrink: 0;
            margin: 0;
            text-align: left;
        }

        /* Top Header Area (Title + Tabs) */
        .top-header-area {
            display: flex;
            align-items: baseline;
            /* Align tabs onto same line as title */
            justify-content: space-between;
            padding: 38px 0 26px 0;
            width: 100%;
        }

        /* Center Gallery Area */
        .gallery-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #fff;
            align-items: center;
            /* Center the grid wrapper */
            justify-content: center;
            /* Vertically center the square */
        }

        /* Tabs styling */
        .gallery-tabs {
            display: flex;
            justify-content: flex-end;
            /* Align right next to title */
            align-items: center;
            background: transparent;
        }

        .gallery-tabs button {
            background: none;
            border: none;
            font-size: 19px;
            color: #999;
            cursor: pointer;
            transition: color 0.3s;
            padding: 0 15px;
            outline: none;
        }

        .gallery-tabs button.active {
            color: #333;
            font-weight: 500;
        }

        .gallery-tabs .tab-divider {
            width: 1px;
            height: 16px;
            background: #ccc;
            margin: 0 5px;
        }

        /* Scrollable Container - Wider and fixed height for horizontal scroll */
        .galleries-container {
            flex: none;
            /* Do not flex, we want a strict height */
            position: relative;
            overflow: hidden;
            width: 95%;
            max-width: 1600px;
            /* Wider to accommodate more images */
            height: clamp(400px, 70vh, 800px);
            /* Strictly defined height so flex-column wraps */
            margin: 0 auto 10px auto;
            border: 1px solid #eee;
            box-sizing: border-box;
        }

        .gallery-grid {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 5px;

            /* CSS Grid for predictable alternating masonry pattern */
            display: grid;
            grid-template-rows: repeat(2, calc(50% - 2.5px));
            /* Force exactly 50% height rows minus half the 5px gap */
            grid-auto-flow: column;
            /* Fill column by column left-to-right */
            grid-auto-columns: max-content;
            /* Size column to fit explicit item widths */
            gap: 5px;
            /* Tighter gap as requested */

            opacity: 0;
            visibility: hidden;
            transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
            /* Scrollbar styling for inner grid */
            scrollbar-width: thin;
            scrollbar-color: #ccc transparent;
        }

        .gallery-grid::-webkit-scrollbar {
            height: 6px;
            /* Horizontal scrollbar height */
        }

        .gallery-grid::-webkit-scrollbar-track {
            background: transparent;
        }

        .gallery-grid::-webkit-scrollbar-thumb {
            background-color: #ccc;
            border-radius: 10px;
        }

        .gallery-grid.active {
            opacity: 1;
            visibility: visible;
        }

        /* Alternating grid masonry layout */
        .gallery-grid>a {
            display: flex;
            /* Flex context to force img stretch */
            box-sizing: border-box;
            height: 100%;
            /* Fill the grid row */
            aspect-ratio: 1 / 1;
            /* Force perfect squares for the 2 verticals */
            width: auto;
            overflow: hidden;
            /* Prevent image overflow from breaking cell */
        }

        /* 
           Pattern: 1 complete, 2 verticals 
           3 items per cycle: 3n+1 is complete, 3n+2 and 3n+3 are verticals
        */

        /* 1 complete (spans 2 full rows, wide column) */
        .gallery-grid>a:nth-child(3n+1) {
            grid-row: span 2;
            aspect-ratio: 1 / 1;
            /* Large perfect square tying seamlessly into the 2 stacked smaller squares */
            width: auto;
        }

        .gallery-grid img {
            flex: 1;
            min-height: 0;
            min-width: 0;
            width: 100%;
            height: 100%;
            /* Let natural aspect ratio define height */
            display: block;
            border-radius: 4px;
            /* Slight polish */
            object-fit: cover;
            cursor: pointer;
            transition: filter 0.3s ease, transform 0.3s ease;
        }

        .gallery-grid img:hover {
            filter: brightness(0.85);
            transform: scale(1.05);
            /* Magnify effect */
        }

        /* Bottom Slider wrapper */
        .subpage-main .projects-wrapper {
            flex-shrink: 0;
            height: 100px;
            /* Restored to exactly 100px */
            overflow: hidden;
            display: flex;
            align-items: center;
            margin-top: 10px;
            background: #fff;
        }

        .bottom-gallery-track {
            display: flex;
            height: 100%;
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            align-items: center;
            scrollbar-width: none;
            /* Hide scrollbar */
        }

        .bottom-gallery-track::-webkit-scrollbar {
            display: none;
        }

        /* Override global work_item height for this subpage */
        .subpage-main .work_item {
            height: 100px !important;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
        }

        /* Ensure link wrapper propagates height */
        .subpage-main .work_item a {
            display: block;
            height: 100%;
        }

        /* Ensure images inside shrink proportionally without cropping top/bottom */
        .subpage-main .work_item img {
            height: 100% !important;
            width: auto !important;
            /* Width auto ensures aspect-ratio constraint dynamically pulls in the sides */
            object-fit: contain !important;
            display: block !important;
            cursor: pointer;
            /* 'contain' fits entire image completely visible inside the 100px height limit */
            transition: filter 0.3s ease, transform 0.3s ease;
        }

        /* Restore slider hover darkening and add zoom */
        .subpage-main .work_item:hover img {
            filter: brightness(0.4);
            transform: scale(1.05) !important;
        }

        /* Mobile specific adjustments */
        @media (max-width: 768px) {

            .subpage-main .projects-wrapper,
            .subpage-main .projects_wrapper,
            .projects-wrapper,
            .projects_wrapper {
                display: none !important;
            }

            .gallery-area {
                justify-content: flex-start;
                overflow: hidden;
            }

            /* Mobile: fill remaining space */
            .galleries-container {
                margin-bottom: 0 !important;
                margin-top: 10px;
                width: 100%;
                height: 100%;
                border: none;
                overflow: hidden;
                position: relative;
            }

            /* Mobile: hide all grids by default (they sit absolute, stacked) */
            .gallery-grid {
                display: none;
                opacity: 1;
                visibility: visible;
            }

            /* Mobile: show active grid as 2-column masonry */
            .gallery-grid.active {
                display: grid;
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                grid-template-columns: repeat(2, 1fr);
                grid-auto-rows: calc(50vw - 4.5px);
                grid-auto-flow: row dense;
                grid-template-rows: unset;
                overflow-x: hidden;
                overflow-y: auto;
                gap: 3px;
                padding: 3px;
                box-sizing: border-box;
            }

            /* All items: fill cell width, height from grid row */
            .gallery-grid.active>a {
                width: 100%;
                height: auto;
                aspect-ratio: unset;
                overflow: hidden;
            }

            /* Every 5th item starting at 1: large square occupying 2 columns */
            .gallery-grid.active>a:nth-child(5n+1) {
                grid-column: span 2;
                grid-row: span 2;
            }

            /* Reset desktop span on other items */
            .gallery-grid.active>a:not(:nth-child(5n+1)) {
                grid-column: span 1;
                grid-row: span 1;
            }

            /* Ensure images fill their cell */
            .gallery-grid.active img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            /* Stack title and tabs vertically on mobile */
            .top-header-area {
                flex-direction: column;
                align-items: flex-start;
                padding: 20px 0 12px 0;
                gap: 18px;
            }

            /* Center tabs below the title */
            .gallery-tabs {
                justify-content: center;
                width: 100%;
            }

            .gallery-tabs button {
                font-size: 18px;
                padding: 0 18px;
            }
        }
    </style>

</head>

